# Copy to .env and fill in. All optional — the app runs in free "sim" mode with none of these set.

# LLM backend the UI defaults to: "sim" (offline, free, no key) or "groq" (real model)
DEFAULT_LLM=sim

# Needed only for groq mode. Get one at https://groq.com/ -> API Keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Safety / limits
ALLOW_LOCAL_PATH=0      # allow analysing a path on the server host (keep 0 for public deploys)
ALLOW_GIT_CLONE=1       # allow shallow-cloning a public https .git URL
MAX_UPLOAD_MB=25
MAX_REPO_FILES=4000
CLONE_TIMEOUT_S=60

# CORS (comma-separated origins, or * )
CORS_ORIGINS=*
